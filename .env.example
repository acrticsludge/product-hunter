# Product Hunter environment: names only. No secret values belong in this file.
# Phase 1 authenticates through the OpenCode auth store, so no provider key is
# needed. Do NOT define DEEPSEEK_API_KEY or any other provider secret here.

PH_PROVIDER=opencode_generate
PH_PROVIDER_ID=opencode-go
PH_MODEL_ID=deepseek-v4.1-flash
PH_EXTRACTOR_VERSION=phase1-0.3
PH_PROMPT_VERSION=extract-v3
PH_NORMALIZATION_VERSION=norm-v1
PH_MAX_INPUT_CHARS=12000
PH_TIMEOUT_SECONDS=120
PH_DB_PATH=db/product_hunter.db

# Optional. Empty until the Phase 7 SubQ gate. The pipeline does not read it today.
SUBQ_API_KEY=

# Optional. The managed-scraping rung (Apify). Both values are empty until
# a managed source is enabled, and the rung is refused by name without
# them. The token stays out of the source registry and out of every log:
# it is read from the environment and redacted from every error detail.
APIFY_TOKEN=

# The actor the managed rung runs. It is configuration for the same reason
# the token is: an actor id that a page could name would be an arbitrary
# tool call.
APIFY_ACTOR_ID=
