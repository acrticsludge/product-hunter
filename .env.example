# Product Hunter environment: names only. No secret values belong in this file.
# Phase 1 authenticates through the OpenCode auth store, so no provider key is
# needed. Do NOT define DEEPSEEK_API_KEY or any other provider secret here.

PH_PROVIDER=opencode_generate
PH_PROVIDER_ID=opencode-go
PH_MODEL_ID=deepseek-v4.1-flash
PH_EXTRACTOR_VERSION=phase1-0.3
PH_PROMPT_VERSION=extract-v3
PH_NORMALIZATION_VERSION=norm-v1
PH_MAX_INPUT_CHARS=12000
PH_TIMEOUT_SECONDS=120
